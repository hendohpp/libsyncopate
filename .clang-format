# run on single file: clang-format -i --style=file <file>
# run on entire codebase: cmake --build --preset debug --target format

Language: Cpp
BasedOnStyle: LLVM

IndentWidth: 4
ColumnLimit: 100
UseTab: Never

BraceWrapping:
  AfterFunction: true
  SplitEmptyFunction: false

PointerAlignment: Left

SpaceBeforeParens: ControlStatements